<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(UDTTargetFramework)</TargetFramework>
    <RootNamespace>UniversalDeviceToolkit.NetworkProxy</RootNamespace>
    <AssemblyName>UniversalDeviceToolkit.NetworkProxy</AssemblyName>
    <Copyright>$(ProjectCopyright)</Copyright>
    <IsUdtShippingApp>true</IsUdtShippingApp>
    <!-- Framework-dependent apphost: without these sidecars the exe is treated as
         self-contained and fails looking for hostpolicy.dll (same class of bug as Host). -->
    <SelfContained>false</SelfContained>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\Device\UniversalDeviceToolkit.Lib.csproj" />
  </ItemGroup>
</Project>
