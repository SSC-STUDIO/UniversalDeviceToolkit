<root><resheader name="resmimetype"><value>text/microsoft-resx</value></resheader><resheader name="version"><value>2.0</value></resheader><resheader name="reader"><value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value></resheader><resheader name="writer"><value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value></resheader><data name="CLI_Header_RootCommandDescription"><value>විධාන රේඛාවෙන් Universal Device Toolkit පාලනය කරන උපයෝගිතාව</value></data><data name="CLI_Option_Language_Description"><value>මෙම උපයෝගිතාව ක්රියාත්මක වීමට Universal Device Toolkit පසුබිමේ ක්රියාත්මක විය යුතු අතර CLI සැකසුම සක්රීය කර තිබිය යුතුය.</value></data><data name="CLI_Command_Status_Description"><value>දර්ශන භාෂාව තාවකාලිකව තෝරාගන්න.</value></data><data name="CLI_Command_QuickAction_Description"><value>ක්රියාත්මක වන යෙදුම් තත්ත්වය සහ ආරම්භ කිරීම් සම්බන්ධ ස්විච පෙන්වන්න</value></data><data name="CLI_Argument_QaName_Description"><value>ඉක්මන් ක්රියාව ක්රියාත්මක කරන්න</value></data><data name="CLI_Option_QaList_Description"><value>ඉක්මන් ක්රියාවේ නම</value></data><data name="CLI_Error_QaNameOrList_Required"><value>{0} හෝ --list සඳහන් කළ යුතුය</value></data><data name="CLI_Command_Feature_Description"><value>පාලන විශේෂාංග</value></data><data name="CLI_Command_GetFeature_Description"><value>විශේෂාංග පාලනය කරන්න</value></data><data name="CLI_Command_SetFeature_Description"><value>විශේෂාංගයක අගය ලබා ගන්න</value></data><data name="CLI_Option_FeatureList_Description"><value>ලබා ගත හැකි විශේෂාංග ලැයිස්තුගත කරන්න</value></data><data name="CLI_Argument_FeatureName_Description"><value>විශේෂාංගයේ නම</value></data><data name="CLI_Argument_FeatureValue_Description"><value>විශේෂාංගයේ අගය</value></data><data name="CLI_Option_FeatureValueList_Description"><value>ලබා ගත හැකි විශේෂාංග අගයන් ලැයිස්තුගත කරන්න</value></data><data name="CLI_Error_FeatureSubcommandOrList_Required"><value>{0}, {1} හෝ --list සඳහන් කළ යුතුය</value></data><data name="CLI_Error_FeatureNameOrList_Required"><value>{0} හෝ --list සඳහන් කළ යුතුය</value></data><data name="CLI_Command_Spectrum_Description"><value>Spectrum පසුබිම් ආලෝකය පාලනය කරන්න</value></data><data name="CLI_Command_SpectrumProfile_Description"><value>Spectrum පසුබිම් ආලෝක වින්යාසය පාලනය කරන්න</value></data><data name="CLI_Command_SpectrumBrightness_Description"><value>Spectrum දීප්තිය පාලනය කරන්න</value></data><data name="CLI_Command_GetSpectrumProfile_Description"><value>වත්මන් Spectrum වින්යාසය ලබා ගන්න</value></data><data name="CLI_Command_SetSpectrumProfile_Description"><value>වත්මන් Spectrum පැතිකඩ සකසන්න</value></data><data name="CLI_Command_GetSpectrumBrightness_Description"><value>වත්මන් Spectrum දීප්තිය ලබා ගන්න</value></data><data name="CLI_Command_SetSpectrumBrightness_Description"><value>වත්මන් Spectrum දීප්තිය සකසන්න</value></data><data name="CLI_Argument_SpectrumProfile_Description"><value>සකසන පැතිකඩ</value></data><data name="CLI_Argument_SpectrumBrightness_Description"><value>සකසන දීප්තිය</value></data><data name="CLI_Command_RGB_Description"><value>RGB පසුබිම් ආලෝකය සඳහා පෙර සැකසුම පාලනය කරන්න</value></data><data name="CLI_Command_GetRGB_Description"><value>වත්මන් RGB පෙර සැකසුම ලබා ගන්න</value></data><data name="CLI_Command_SetRGB_Description"><value>වත්මන් RGB පෙර සැකසුම සකසන්න</value></data><data name="CLI_Argument_RGBPreset_Description"><value>සකසන පෙර සැකසුම</value></data><data name="CLI_Command_Shell_Description"><value>ශීර්ෂය සන්දර්භීය මෙනු ව්යාප්තිය කළමනාකරණය කරන්න (Nilesoft Shell)</value></data><data name="CLI_Option_ShellStatus_Description"><value>වත්මන් ලියාපදිංචි තත්ත්වය පරීක්ෂා කරන්න</value></data><data name="CLI_Option_ShellInstall_Description"><value>Nilesoft Shell ස්ථාපනය කරන්න</value></data><data name="CLI_Option_ShellUninstall_Description"><value>Nilesoft Shell ඉවත් කරන්න</value></data><data name="CLI_Option_ShellInstallStatus_Description"><value>වත්මන් ස්ථාපන තත්ත්වය පරීක්ෂා කරන්න</value></data><data name="CLI_Shell_RegisteredYes"><value>Shell ලියාපදිංචි කර ඇත</value></data><data name="CLI_Shell_RegisteredNo"><value>Shell ලියාපදිංචි කර නොමැත</value></data><data name="CLI_Shell_InstalledYes"><value>Shell ස්ථාපනය කර ඇත</value></data><data name="CLI_Shell_InstalledNo"><value>Shell ස්ථාපනය කර නොමැත</value></data><data name="CLI_Shell_InstallInitiated"><value>Shell ස්ථාපන ක්රියාවලිය ආරම්භ කරන ලදී</value></data><data name="CLI_Shell_UninstallInitiated"><value>Shell ඉවත් කිරීමේ ක්රියාවලිය ආරම්භ කරන ලදී</value></data><data name="CLI_Shell_NoAction_Hint"><value>කරුණාකර ක්රියාවක් සඳහන් කරන්න:</value></data><data name="CLI_Shell_NoAction_Status"><value>--status (-s): වත්මන් ලියාපදිංචි තත්ත්වය පරීක්ෂා කරන්න</value></data><data name="CLI_Shell_NoAction_Install"><value>--install (-i): Nilesoft Shell ස්ථාපනය කරන්න</value></data><data name="CLI_Shell_NoAction_Uninstall"><value>--uninstall (-x): Nilesoft Shell ඉවත් කරන්න</value></data><data name="CLI_Shell_NoAction_InstallStatus"><value>--install-status (-is): වත්මන් ස්ථාපන තත්ත්වය පරීක්ෂා කරන්න</value></data><data name="CLI_Error_ShellOnlyOneAction"><value>කරුණාකර එකවර ක්රියාවක් පමණක් සඳහන් කරන්න</value></data><data name="CLI_Error_ShellAtLeastOneAction"><value>අවම වශයෙන් ක්රියාකාරී විකල්පයක් සඳහන් කළ යුතුය</value></data><data name="CLI_Command_Network_Description"><value>ජාල ත්වරණය කළමනාකරණය</value></data><data name="CLI_Option_NetworkStatus_Description"><value>ජාල ත්වරණ තත්ත්වය පෙන්වන්න</value></data><data name="CLI_Option_NetworkStart_Description"><value>ජාල ත්වරණය පැහැදිලිව ආරම්භ කරන්න</value></data><data name="CLI_Option_NetworkStop_Description"><value>ජාල ත්වරණය නැවැත්වීම සහ තත්ත්වය යථා තත්ත්වයට පත් කිරීම</value></data><data name="CLI_Option_NetworkDiagnostics_Description"><value>පද්ධති තත්ත්වය වෙනස් නොකර ජාල රෝග විනිශ්චය ක්රියාත්මක කරන්න</value></data><data name="CLI_Error_NetworkOnlyOneAction"><value>එක් වරකට ජාල ක්රියාකාරකමක් පමණක් සඳහන් කරන්න</value></data><data name="CLI_Error_NetworkAtLeastOneAction"><value>අවම වශයෙන් ජාල ක්රියාකාරකම් විකල්පයක් සඳහන් කළ යුතුය</value></data><data name="CLI_IpcError_ConnectFailed"><value>සම්බන්ධ වීමට අසමත් විය. Universal Device Toolkit පසුබිමෙන් ක්රියාත්මක වන බවත් සහ CLI සැකසුම් වල සක්රීය කර ඇති බවත් තහවුරු කරන්න.</value></data><data name="CLI_IpcError_MissingReturnMessage"><value>ප්රතිචාර පණිවිඩය නැත</value></data><data name="CLI_IpcError_AuthChallengeFailed"><value>සත්යාපන අභියෝගය ලැබීමට අපොහොසත් විය</value></data><data name="CLI_IpcError_UnknownFailure"><value>නොදන්නා අසාර්ථකත්වය</value></data><data name="CLI_Loading_ListFeatures"><value>විශේෂාංග පූරණය වෙමින් පවතී</value></data><data name="CLI_Loading_ListFeatureValues"><value>අගයන් පූරණය වෙමින් පවතී</value></data><data name="CLI_Loading_ListQuickActions"><value>ක්ෂණික ක්රියා පටිපාටියක් පූරණය වෙමින්</value></data><data name="CLI_Loading_GetFeatureValue"><value>විශේෂාංගයක් කියවමින්</value></data><data name="CLI_Loading_SetFeatureValue"><value>විශේෂාංගය යෙදීම</value></data><data name="CLI_Loading_GetSpectrumProfile"><value>Spectrum ප්රොෆයිල් එක කියවමින්</value></data><data name="CLI_Loading_SetSpectrumProfile"><value>Spectrum ප්රොෆයිල් එක යෙදීම</value></data><data name="CLI_Loading_GetSpectrumBrightness"><value>Spectrum දීප්තිය කියවමින්</value></data><data name="CLI_Loading_SetSpectrumBrightness"><value>Spectrum දීප්තිය යෙදීම</value></data><data name="CLI_Loading_GetRGBPreset"><value>RGB පෙර සැකසුම කියවමින්</value></data><data name="CLI_Loading_SetRGBPreset"><value>RGB පෙර සැකසුම යෙදීම</value></data><data name="CLI_Loading_QuickAction"><value>ක්ෂණික ක්රියාවක් ක්රියාත්මක වෙමින්</value></data><data name="CLI_Loading_IsShellRegistered"><value>Shell ලියාපදිංචිය පරීක්ෂා කිරීම</value></data><data name="CLI_Loading_IsShellInstalled"><value>Shell ස්ථාපනය පරීක්ෂා කිරීම</value></data><data name="CLI_Loading_InstallShell"><value>Shell ස්ථාපන ක්රියාවලිය ආරම්භ කරමින්...</value></data><data name="CLI_Loading_UninstallShell"><value>Shell ඉවත් කිරීමේ ක්රියාවලිය ආරම්භ කිරීම</value></data><data name="CLI_Loading_GetAppStatus"><value>යෙදුම් තත්ත්වය පරීක්ෂා කරයි</value></data><data name="CLI_Loading_GetNetworkAccelerationStatus"><value>ජාල ත්වරණය පරීක්ෂා කරමින්...</value></data><data name="CLI_Loading_StartNetworkAcceleration"><value>ජාල ත්වරණ ක්රියාවලිය ආරම්භ කිරීම</value></data><data name="CLI_Loading_StopNetworkAcceleration"><value>ජාල ත්වරණය නැවැත්වීම</value></data><data name="CLI_Loading_RunNetworkDiagnostics"><value>Network Diagnostics සිදු කරමින්...</value></data><data name="CLI_Loading_Default"><value>Universal Device Toolkit සඳහා රැඳී සිටීම</value></data></root>