{
  "name": "universal-device-toolkit-electron",
  "productName": "Universal Device Toolkit",
  "version": "6.1.1",
  "description": "Universal Device Toolkit - Electron desktop client",
  "author": "Universal Device Toolkit Contributors",
  "homepage": "https://github.com/SSC-STUDIO/UniversalDeviceToolkit",
  "license": "GPL-3.0-or-later",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-host.mjs && electron-vite dev",
    "dev:bridge": "node scripts/ensure-host.mjs && node scripts/dev-bridge-server.mjs",
    "dev:bridge:stop": "node scripts/dev-bridge-stop.mjs",
    "dev:web": "node scripts/ensure-host.mjs && node scripts/dev-web.mjs",
    "dev:trace": "node scripts/ensure-host.mjs && electron-vite dev -- --trace",
    "dev:minimized": "node scripts/ensure-host.mjs && electron-vite dev -- --minimized",
    "dev:trace-minimized": "node scripts/ensure-host.mjs && electron-vite dev -- --trace --minimized",
    "dev:single": "node scripts/ensure-host.mjs && electron-vite dev -- --single-process",
    "preview:installer": "electron installer/main.mjs --preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test tests/*.mjs",
    "lint": "eslint .",
    "start": "node scripts/ensure-host.mjs && electron-vite preview",
    "dist": "npm run build && electron-builder --config electron-builder.yml",
    "dist:win": "npm run build && node scripts/build-custom-installer.mjs",
    "dist:mac": "npm run build && electron-builder --config electron-builder.yml --mac",
    "dist:linux": "npm run build && electron-builder --config electron-builder.yml --linux"
  },
  "dependencies": {},
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@fluentui/react-icons": "^2.0.316",
    "antd": "^6.6.0",
    "echarts": "^6.1.0",
    "i18next": "^26.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.14",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6"
  }
}
