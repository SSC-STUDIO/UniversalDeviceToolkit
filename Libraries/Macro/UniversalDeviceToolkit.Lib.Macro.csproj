<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
    <TargetFramework>$(UDTTargetFramework)</TargetFramework>
    <RootNamespace>UniversalDeviceToolkit.Lib.Macro</RootNamespace>
		<ImplicitUsings>disable</ImplicitUsings>
		<Copyright>$(ProjectCopyright)</Copyright>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<NeutralLanguage>en</NeutralLanguage>
		<!-- No WinForms: System.Drawing.Rectangle flows transitively from Lib's
		     System.Drawing.Common package reference. -->
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\Device\UniversalDeviceToolkit.Lib.csproj" />
		<ProjectReference Include="..\Abstractions\UniversalDeviceToolkit.Lib.Abstractions.csproj" />
	</ItemGroup>
	<!-- MacroController/recorder/player install WH_KEYBOARD_LL hooks via CsWin32;
	     only the portable models + type converters compile for net10.0. -->
	<ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows10.0.26100.0'">
	  <Compile Remove="MacroController.cs" />
	  <Compile Remove="Utils\MacroHookPump.cs" />
	  <Compile Remove="Utils\MacroPlayer.cs" />
	  <Compile Remove="Utils\MacroRecorder.cs" />
	  <Compile Remove="Utils\MacroSettings.cs" />
	</ItemGroup>
	<ItemGroup>
	  <Compile Update="Resources\Resource.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resource.resx</DependentUpon>
	  </Compile>
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Update="Resources\Resource.resx">
	    <Generator>PublicResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resource.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>
</Project>
