<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>$(UDTTargetFramework)</TargetFramework>
		<RootNamespace>UniversalDeviceToolkit.Lib.Automation</RootNamespace>
		<Copyright>$(ProjectCopyright)</Copyright>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<NeutralLanguage>en</NeutralLanguage>
	</PropertyGroup>
	<ItemGroup>
<PackageReference Include="Autofac" />
    <PackageReference Include="NeoSmart.AsyncLock" />
    <!-- SoundPlayer (System.Media) previously flowed from the implicit Windows
         Desktop reference pack via Lib's UseWindowsForms; reference it
         explicitly now that the desktop stack is gone. -->
    <PackageReference Include="System.Windows.Extensions" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\Device\UniversalDeviceToolkit.Lib.csproj" />
	  <ProjectReference Include="..\Abstractions\UniversalDeviceToolkit.Lib.Abstractions.csproj" />
	  <ProjectReference Include="..\CLI\UniversalDeviceToolkit.CLI.Lib.csproj" />
	</ItemGroup>
