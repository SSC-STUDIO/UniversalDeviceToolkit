<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>UniversalDeviceToolkit.Abstractions</RootNamespace>
    <!-- Portable net10.0: do not force win-x64 RID or PlatformTarget=x64 -->
